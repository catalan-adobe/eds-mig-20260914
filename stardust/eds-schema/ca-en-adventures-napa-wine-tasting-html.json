    {
      "section": "adventure-details",
      "items": [
        {
          "role": "eyebrow",
          "order": 0,
          "text": "Overview"
        },
        {
          "role": "eyebrow",
          "order": 1,
          "text": "Itinerary"
        },
        {
          "role": "eyebrow",
          "order": 2,
